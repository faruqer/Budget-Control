<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BudgetControl" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- The colour theme. These five are all a Theme.BudgetControl.* variant replaces;
             the values here are the default one, Mono. -->
        <item name="accentColor">@color/mono_accent</item>
        <item name="accentStartColor">@color/mono_start</item>
        <item name="accentEndColor">@color/mono_end</item>
        <item name="onAccentColor">@color/mono_on</item>
        <item name="accentInkColor">@color/mono_ink</item>

        <item name="colorPrimary">?attr/accentInkColor</item>
        <item name="colorOnPrimary">@color/on_accent_ink</item>
        <item name="colorPrimaryContainer">?attr/accentColor</item>
        <item name="colorOnPrimaryContainer">?attr/onAccentColor</item>
        <item name="colorSecondary">?attr/accentInkColor</item>
        <item name="colorOnSecondary">@color/on_accent_ink</item>
        <item name="colorSecondaryContainer">?attr/accentColor</item>
        <item name="colorOnSecondaryContainer">?attr/onAccentColor</item>
        <item name="colorTertiary">?attr/accentInkColor</item>
        <item name="colorOnTertiary">@color/on_accent_ink</item>
        <item name="colorTertiaryContainer">?attr/accentColor</item>
        <item name="colorOnTertiaryContainer">?attr/onAccentColor</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/status_over</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BudgetControl.BottomSheet</item>
    </style>

    <!-- Colour themes, picked in Settings and applied by each activity before it draws.
         Each one is the base theme with its five colours swapped. -->
    <style name="Theme.BudgetControl.Neon">
        <item name="accentColor">@color/neon_accent</item>
        <item name="accentStartColor">@color/neon_start</item>
        <item name="accentEndColor">@color/neon_end</item>
        <item name="onAccentColor">@color/neon_on</item>
        <item name="accentInkColor">@color/neon_ink</item>
    </style>

    <style name="Theme.BudgetControl.Electric">
        <item name="accentColor">@color/electric_accent</item>
        <item name="accentStartColor">@color/electric_start</item>
        <item name="accentEndColor">@color/electric_end</item>
        <item name="onAccentColor">@color/electric_on</item>
        <item name="accentInkColor">@color/electric_ink</item>
    </style>

    <style name="Theme.BudgetControl.Berry">
        <item name="accentColor">@color/berry_accent</item>
        <item name="accentStartColor">@color/berry_start</item>
        <item name="accentEndColor">@color/berry_end</item>
        <item name="onAccentColor">@color/berry_on</item>
        <item name="accentInkColor">@color/berry_ink</item>
    </style>

    <style name="Theme.BudgetControl.Lagoon">
        <item name="accentColor">@color/lagoon_accent</item>
        <item name="accentStartColor">@color/lagoon_start</item>
        <item name="accentEndColor">@color/lagoon_end</item>
        <item name="onAccentColor">@color/lagoon_on</item>
        <item name="accentInkColor">@color/lagoon_ink</item>
    </style>

    <style name="Theme.BudgetControl.Mono" />

    <style name="ThemeOverlay.BudgetControl.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BudgetControl.BottomSheet</item>
    </style>

    <style name="Widget.BudgetControl.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BudgetControl.Sheet</item>
    </style>

    <style name="ShapeAppearance.BudgetControl.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Text -->
    <style name="Text" />

    <style name="Text.ScreenTitle">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Figure">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.TileValue">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- One row on the Settings screen -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

</resources>
